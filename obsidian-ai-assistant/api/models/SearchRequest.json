{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SearchRequest",
  "description": "Schema for note search requests",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "description": "Search query string",
      "minLength": 1
    },
    "searchType": {
      "type": "string",
      "description": "Type of search to perform",
      "enum": ["semantic", "text", "tags"],
      "default": "semantic"
    },
    "filters": {
      "type": "object",
      "description": "Additional filters for the search",
      "properties": {
        "folder": {
          "type": "string",
          "description": "Filter notes by folder"
        },
        "tags": {
          "type": "array",
          "description": "Filter notes by tags",
          "items": {
            "type": "string"
          }
        },
        "dateRange": {
          "type": "object",
          "description": "Filter notes by date range",
          "properties": {
            "startDate": {
              "type": "string",
              "description": "Start date (ISO 8601)",
              "format": "date-time"
            },
            "endDate": {
              "type": "string",
              "description": "End date (ISO 8601)",
              "format": "date-time"
            }
          }
        }
      }
    },
    "limit": {
      "type": "integer",
      "description": "Maximum number of results to return",
      "minimum": 1,
      "maximum": 100,
      "default": 10
    },
    "offset": {
      "type": "integer",
      "description": "Number of results to skip for pagination",
      "minimum": 0,
      "default": 0
    }
  },
  "required": ["query"],
  "additionalProperties": false
} 